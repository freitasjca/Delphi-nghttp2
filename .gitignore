tests/interlocked_check
# Same class, missed until 2026-09-07: it was COMMITTED, and a Windows build
# then deleted it, which is how it surfaced. A compiled binary with no
# extension slips past *.exe every time.
tests/Nghttp2ProtobufTests

# Test-runner output (run-tests.bat writes one per stage)
*.buildlog

# protogen (tools/protogen) build + tooling output
# .venv is a 46 MB Python virtualenv holding grpcio-tools for the protoc
# oracle; .oracle-out holds the generated corpus and a compiled ProtogenCheck.
# Both are reproducible from protoc-oracle.sh and neither belongs in history.
tools/protogen/.venv/
tools/protogen/.oracle-out/
tools/protogen/ProtogenParserTests
tools/protogen/ProtogenCheck

# interop test scratch (tests/interop): the generated Python module, the case
# and round-trip .bin files, and the compiled codec binary. All reproducible by
# interop_check.py. The binary has no extension, so *.exe does not cover it.
#
# GLOB, not a literal: --work names the scratch directory, so every run can
# pick a new one (.interop-out from build-codec-fpc.sh, .interop-delphi from a
# split-mode run, whatever the next one is called). The first commit of this
# directory swept in 66 artefacts under the one name that existed then;
# matching the prefix means a new --work value cannot repeat that.
#
# Committing any of it would be worse than clutter: interop_pb2.py is
# regenerated by grpc_tools.protoc at run time, so a committed copy pins a
# snapshot that drifts from whatever protobuf later runs use, and committed
# cases/*.bin invite treating fixtures as truth instead of regenerating them
# from the reference. Either quietly turns the one independent check in this
# repo back into a self-referential one.
.interop-*/
__pycache__/
tests/interop/Nghttp2InteropCodec

# corpus-check.sh scratch: a multi-hundred-MB clone and a compiled
# binary with no extension (so *.exe does not cover it).
tools/protogen/.corpus/
tools/protogen/.corpus-out/

# compile-check.sh output: thousands of generated units per --all run
tools/protogen/.compile-out/
tools/protogen/.spot-out/

# The qualified-reference probe's build output. FOURTH time an extensionless
# compiled binary has been staged in this repo -- the three comments above say
# the same thing about three other directories. The probe is built by hand
# (see the header of ProtoQualRefProbe.dpr), so its output lands wherever -FE
# points; keep the whole directory out.
tests/qualref/out/
